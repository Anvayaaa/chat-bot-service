PORT=5100
NODE_ENV=development

# Must be the same value as ASSISTANT_TOKEN_SECRET in the CRM backend's .env.
ASSISTANT_TOKEN_SECRET=

# The assistant's own database (not the CRM's), e.g. .../chat_bot_service
MONGO_URI=

# AI provider. Get a key at console.groq.com. Pick a model that supports tool use.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Where the CRM's API lives.
CRM_API_URL=http://localhost:5000/api/v1

# Browser addresses allowed to call this service (the CRM frontend), comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

# Messages one person may send per minute (protects the AI provider's free quota).
PER_MINUTE_LIMIT=8
# Monthly messages per company when the CRM doesn't send one.
DEFAULT_MONTHLY_LIMIT=300
